{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm check)",
      "Bash(pnpm check:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm knip)",
      "Bash(pnpm build)",
      "Bash(pnpm verify)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(docker compose down -v:*)",
      "Bash(prisma migrate deploy:*)",
      "Bash(pnpm prisma migrate deploy:*)",
      "Bash(drizzle-kit push:*)",
      "Bash(pnpm drizzle-kit push:*)",
      "Read(./.env)",
      "Read(./.env.production)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production.local)",
      "Bash(cat .env*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin +main:*)"
    ]
  }
}
