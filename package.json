{
  "name": "web-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "knip": "knip",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "template:init": "node scripts/init/index.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.0",
    "@tanstack/react-query": "^5.100.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tanstack/react-query-devtools": "^5.100.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "sass": "^1.107.1",
    "secretlint": "^13.1.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
