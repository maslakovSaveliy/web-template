# Copy to .env.local for development. Never commit real values.

# --- Public (inlined into the browser bundle at BUILD time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL for apiFetch(). "/" = same origin (route handlers). Or e.g. https://api.example.com
NEXT_PUBLIC_API_URL=/

# --- Server only (validated at server start, src/instrumentation.ts) ---
APP_PORT=3000
